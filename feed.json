            "content_html": "<table style=\"border-collapse: collapse; width: 100%;\" border=\"1\">\n<tbody>\n<tr>\n<td style=\"width: 49.9407%;\"><figure class=\"post__image\"><img loading=\"lazy\"  style=\"outline: rgba(13, 139, 242, 0.55) solid 2.49351px !important;\" src=\"https://iainsm.github.io/biocycle_test/media/posts/13/1664375215323.jpg\" alt=\"\" width=\"333\" height=\"328\" sizes=\"(max-width: 1024px) 100vw, 1024px\" srcset=\"https://iainsm.github.io/biocycle_test/media/posts/13/responsive/1664375215323-xs.jpg 300w ,https://iainsm.github.io/biocycle_test/media/posts/13/responsive/1664375215323-sm.jpg 480w ,https://iainsm.github.io/biocycle_test/media/posts/13/responsive/1664375215323-md.jpg 768w ,https://iainsm.github.io/biocycle_test/media/posts/13/responsive/1664375215323-lg.jpg 1024w\"></figure></td>\n<td style=\"width: 49.9407%;\"><figure class=\"post__image\"><img loading=\"lazy\"  style=\"outline: rgba(13, 139, 242, 0.55) solid 2.49351px !important;\" src=\"https://iainsm.github.io/biocycle_test/media/posts/13/1664375215323.jpg\" alt=\"\" width=\"333\" height=\"328\" sizes=\"(max-width: 1024px) 100vw, 1024px\" srcset=\"https://iainsm.github.io/biocycle_test/media/posts/13/responsive/1664375215323-xs.jpg 300w ,https://iainsm.github.io/biocycle_test/media/posts/13/responsive/1664375215323-sm.jpg 480w ,https://iainsm.github.io/biocycle_test/media/posts/13/responsive/1664375215323-md.jpg 768w ,https://iainsm.github.io/biocycle_test/media/posts/13/responsive/1664375215323-lg.jpg 1024w\"></figure></td>\n</tr>\n<tr>\n<td style=\"width: 49.9407%;\">Desciption here</td>\n<td style=\"width: 49.9407%;\">Description here</td>\n</tr>\n<tr>\n<td style=\"width: 49.9407%;\"><figure class=\"post__image\"><img loading=\"lazy\"  style=\"outline: rgba(13, 139, 242, 0.55) solid 2.49351px !important;\" src=\"https://iainsm.github.io/biocycle_test/media/posts/13/1664375215323.jpg\" alt=\"\" width=\"333\" height=\"328\" sizes=\"(max-width: 1024px) 100vw, 1024px\" srcset=\"https://iainsm.github.io/biocycle_test/media/posts/13/responsive/1664375215323-xs.jpg 300w ,https://iainsm.github.io/biocycle_test/media/posts/13/responsive/1664375215323-sm.jpg 480w ,https://iainsm.github.io/biocycle_test/media/posts/13/responsive/1664375215323-md.jpg 768w ,https://iainsm.github.io/biocycle_test/media/posts/13/responsive/1664375215323-lg.jpg 1024w\"></figure></td>\n<td style=\"width: 49.9407%;\"><figure class=\"post__image\"><img loading=\"lazy\"  style=\"outline: rgba(13, 139, 242, 0.55) solid 2.49351px !important;\" src=\"https://iainsm.github.io/biocycle_test/media/posts/13/1664375215323.jpg\" alt=\"\" width=\"333\" height=\"328\" sizes=\"(max-width: 1024px) 100vw, 1024px\" srcset=\"https://iainsm.github.io/biocycle_test/media/posts/13/responsive/1664375215323-xs.jpg 300w ,https://iainsm.github.io/biocycle_test/media/posts/13/responsive/1664375215323-sm.jpg 480w ,https://iainsm.github.io/biocycle_test/media/posts/13/responsive/1664375215323-md.jpg 768w ,https://iainsm.github.io/biocycle_test/media/posts/13/responsive/1664375215323-lg.jpg 1024w\"></figure></td>\n</tr>\n<tr>\n<td style=\"width: 49.9407%;\">\n<h2 class=\"list-item-content__title\" style=\"margin-top: 2.28571rem; color: #02192b; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif; font-weight: bold; letter-spacing: -0.54px; font-size: 1.60181em;\">Jaya Joshi, Principal Investigator</h2>\n<div class=\"list-item-content__description\n          \n          \">\n<p class=\"\" data-rte-preserve-empty=\"true\">Jaya Joshi is a synthetic biologist interested in the directed evolution of enzymes to transform inefficient designer biocatalysts into highly active enzymes. Her research walks through enzyme design space: exploring fitness landscapes for radical metabolic engineering design ideas, guided by the aim of successful implementation of carbon farming by 2050.</p>\n</div>\n</td>\n<td style=\"width: 49.9407%;\">Description here</td>\n</tr>\n<tr>\n<td style=\"width: 49.9407%;\"> </td>\n<td style=\"width: 49.9407%;\"> </td>\n</tr>\n</tbody>\n</table>\n<p>  </p>",
